{
  "name": "@direct-democracy-solutions/elasticsearch-migration",
  "version": "1.2.1",
  "description": "Elasticsearch/OpenSearch migration tool",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "es-migrate": "dist/cli.js"
  },
  "scripts": {
    "format": "prettier --write --list-different .",
    "lint": "eslint",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/cli.ts",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "pre-commit": "npm ci && eslint --max-warnings=0 && prettier --check . && npm run build && test"
  },
  "keywords": [
    "elasticsearch",
    "opensearch",
    "migration",
    "database",
    "schema",
    "cli",
    "typescript"
  ],
  "author": "Ahmet Kasap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/direct-democracy-solutions/elasticsearch-migration.git"
  },
  "bugs": {
    "url": "https://github.com/direct-democracy-solutions/elasticsearch-migration/issues"
  },
  "homepage": "https://github.com/direct-democracy-solutions/elasticsearch-migration#readme",
  "dependencies": {
    "@opensearch-project/opensearch": "^2.4.0",
    "commander": "^11.1.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@eslint/json": "^1.0.1",
    "@eslint/markdown": "^8.0.0",
    "@release-it/keep-a-changelog": "^7.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "eslint": "^10.0.1",
    "globals": "^16.4.0",
    "jest": "^30.2.0",
    "jiti": "^2.6.0",
    "prettier": "^3.6.2",
    "release-it": "^21.0.2",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.44.1"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^18 || ^20 || ^22 || ^24 || ^25 || ^26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">= 22.21.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "^10.9.3 || ^11.5.1"
    }
  }
}
